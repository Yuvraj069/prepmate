# Flask: generate a long random value before deploying
FLASK_SECRET_KEY=replace-with-a-long-random-secret

# Supabase: enables cloud account storage and authentication
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Microsoft Foundry / Azure OpenAI: enables GenAI and future RAG retrieval.
# Foundry project endpoints (ending in services.ai.azure.com/openai/v1) use your
# Azure sign-in locally, so AZURE_OPENAI_API_KEY can remain empty.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_DEPLOYMENT=your-chat-model-deployment
AZURE_OPENAI_API_VERSION=2024-10-21

# Azure AI Search: grounds responses in your approved interview material (RAG)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-search-admin-or-query-key
AZURE_SEARCH_INDEX=interview-knowledge

# Azure AI Speech: enables spoken answers and audio-file transcription
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=eastus
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural
